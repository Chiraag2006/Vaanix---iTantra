<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>iTantra — Semantic Voice Relay</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#080D18;
    --panel:#0F1830;
    --panel2:#16213E;
    --line:#22304F;
    --text:#EEF2FA;
    --muted:#7C89A8;
    --amber:#FF7A33;
    --cyan:#33E6C8;
    --violet:#9C8CFF;
    --danger:#FF4D5E;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-sizing:border-box;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){ --bg:#080D18; --panel:#0F1830; --text:#EEF2FA; }
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'Rajdhani',system-ui,sans-serif;overflow-x:hidden;}
  body{padding:18px 16px 40px;max-width:1180px;margin:0 auto;}
  .mono{font-family:'JetBrains Mono',monospace;}

  header{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:10px;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:18px;}
  header h1{font-size:24px;font-weight:700;margin:0;letter-spacing:.3px;}
  header h1 span{color:var(--amber);}
  header p{margin:2px 0 0;color:var(--muted);font-size:13px;}
  .badge{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--cyan);border:1px solid var(--cyan);padding:3px 8px;border-radius:3px;white-space:nowrap;}

  /* pipeline strip */
  .pipeline{display:flex;align-items:center;gap:0;margin-bottom:20px;overflow-x:auto;padding-bottom:4px;}
  .node{flex:1;min-width:150px;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:10px 12px;text-align:center;position:relative;transition:border-color .25s,box-shadow .25s;}
  .node small{display:block;color:var(--muted);font-size:10px;margin-top:2px;font-family:'JetBrains Mono',monospace;}
  .node b{font-size:13px;letter-spacing:.5px;}
  .node.active{border-color:var(--cyan);box-shadow:0 0 14px -2px rgba(51,230,200,.5);}
  .wire{width:26px;height:2px;background:var(--line);position:relative;flex-shrink:0;}
  .wire.on{background:var(--cyan);}
  .wire.on::after{content:'';position:absolute;top:-2px;left:0;width:6px;height:6px;border-radius:50%;background:var(--cyan);animation:flow 1.1s linear infinite;}
  @keyframes flow{from{left:0;}to{left:calc(100% - 6px);}}

  .grid{display:grid;grid-template-columns:1fr 1.3fr;gap:14px;}
  @media (max-width:760px){.grid{grid-template-columns:1fr;}}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:16px;}
  .panel h2{font-size:14px;margin:0 0 12px;letter-spacing:.4px;color:var(--text);display:flex;align-items:center;gap:8px;}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--muted);}
  .dot.live{background:var(--amber);box-shadow:0 0 8px var(--amber);}
  .dot.ok{background:var(--cyan);box-shadow:0 0 8px var(--cyan);}

  /* input panel */
  .ptt{width:100%;padding:16px;border-radius:8px;border:1px solid var(--amber);background:rgba(255,122,51,.08);color:var(--amber);font-family:'Rajdhani',sans-serif;font-weight:700;font-size:16px;letter-spacing:.5px;cursor:pointer;transition:.15s;}
  .ptt:active{transform:scale(.98);}
  .ptt.recording{background:var(--amber);color:#1a0e05;box-shadow:0 0 22px -2px rgba(255,122,51,.7);}
  .lang-row{display:flex;gap:8px;margin-top:10px;}
  select{flex:1;background:var(--panel2);border:1px solid var(--line);color:var(--text);padding:8px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:12px;}
  canvas{width:100%;height:64px;display:block;margin-top:12px;border-radius:6px;background:#060A14;}
  .vad-state{margin-top:10px;font-size:12px;font-family:'JetBrains Mono',monospace;color:var(--muted);display:flex;justify-content:space-between;}
  .vad-state b{color:var(--text);}
  .demo-row{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap;}
  .chip{font-size:11px;font-family:'JetBrains Mono',monospace;border:1px solid var(--line);color:var(--muted);padding:5px 8px;border-radius:14px;cursor:pointer;background:transparent;}
  .chip:hover{border-color:var(--cyan);color:var(--cyan);}
  .note{font-size:11px;color:var(--muted);margin-top:12px;line-height:1.5;border-top:1px dashed var(--line);padding-top:10px;}

  /* transcript panel */
  .transcript{min-height:150px;max-height:220px;overflow-y:auto;font-family:'JetBrains Mono',monospace;font-size:14px;line-height:1.6;padding:10px;background:#060A14;border-radius:6px;border:1px solid var(--line);}
  .transcript .final{color:var(--text);}
  .transcript .interim{color:var(--muted);}
  .cursor{display:inline-block;width:7px;height:14px;background:var(--cyan);vertical-align:-2px;animation:blink 1s step-end infinite;}
  @keyframes blink{50%{opacity:0;}}
  .stat-row{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;}
  .stat{flex:1;min-width:90px;background:var(--panel2);border-radius:6px;padding:8px 10px;}
  .stat span{display:block;font-size:10px;color:var(--muted);font-family:'JetBrains Mono',monospace;}
  .stat b{font-size:16px;font-family:'JetBrains Mono',monospace;color:var(--cyan);}

  /* language layer */
  .lang-panel{margin-top:14px;}
  .lang-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px;}
  .field{background:var(--panel2);border-radius:6px;padding:10px;}
  .field span{display:block;font-size:10px;color:var(--muted);font-family:'JetBrains Mono',monospace;margin-bottom:3px;}
  .field b{font-size:15px;}
  .field b.urgent{color:var(--danger);}
  .field b.normal{color:var(--cyan);}
  .bars{display:flex;align-items:flex-end;gap:14px;margin:10px 0 4px;}
  .bar-col{flex:1;text-align:center;}
  .bar-track{height:70px;display:flex;align-items:flex-end;background:#060A14;border-radius:4px;overflow:hidden;}
  .bar-fill{width:100%;transition:height .4s;}
  .bar-fill.audio{background:linear-gradient(var(--muted),transparent);}
  .bar-fill.text{background:linear-gradient(var(--cyan),transparent);}
  .bar-col small{display:block;margin-top:5px;color:var(--muted);font-size:10px;font-family:'JetBrains Mono',monospace;}
  pre.payload{background:#060A14;border:1px solid var(--line);border-radius:6px;padding:12px;font-size:12px;overflow-x:auto;color:var(--violet);}

  footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-top:20px;padding-top:12px;border-top:1px solid var(--line);color:var(--muted);font-size:11px;font-family:'JetBrains Mono',monospace;}

  .diag{display:none;margin-top:12px;padding:10px 12px;border-radius:6px;border:1px solid var(--danger);background:rgba(255,77,94,.08);color:var(--danger);font-size:12px;font-family:'JetBrains Mono',monospace;line-height:1.5;}
  .diag.show{display:block;}
  .diag b{color:var(--text);}
</style>
</head>
<body>

<header>
  <div>
    <h1>iTantra<span>::</span>relay</h1>
    <p>Blocks 1–3 prototype — voice input · VAD+STT · language layer</p>
  </div>
  <span class="badge mono" id="statusBadge">STANDBY</span>
</header>

<div class="pipeline">
  <div class="node" id="node1"><b>VOICE INPUT</b><small>mic / radio</small></div>
  <div class="wire" id="wire1"></div>
  <div class="node" id="node2"><b>VAD + STT</b><small>streaming ASR</small></div>
  <div class="wire" id="wire2"></div>
  <div class="node" id="node3"><b>LANGUAGE LAYER</b><small>lang id · intent</small></div>
</div>

<div class="grid">
  <div class="panel">
    <h2><span class="dot" id="dotMic"></span>Voice input</h2>
    <div class="demo-row" style="margin-top:0;">
      <button class="chip" data-demo="en" data-text="flood warning move to higher ground immediately">flood alert (en)</button>
      <button class="chip" data-demo="hi" data-text="बाढ़ की चेतावनी तुरंत ऊँचे स्थान पर जाएँ">flood alert (hi)</button>
      <button class="chip" data-demo="en2" data-text="all clear you may return to your homes now">all-clear (en)</button>
    </div>
    <div class="note" style="border-top:none;padding-top:2px;">Fixed alert phrases, injected straight into VAD+STT and the language layer below — the same demo-phrase fallback the problem statement itself recommends for a live pitch, since it can't fail on stage.</div>

    <div class="note" style="border-top:1px dashed var(--line);padding-top:10px;margin-top:14px;">
      <b style="color:var(--text);">Bonus — try live mic</b><br>
      Stands in for the on-device Vosk-Indic/IndicConformer model this pipeline targets. Needs mic permission granted <i>to this exact tab</i> — some embedded/preview views can't get it even after you allow it in Chrome settings, since that's a page-hosting limit, not a permission you control.
    </div>
    <button class="ptt" id="pttBtn" style="margin-top:8px;">HOLD TO TALK (LIVE MIC)</button>
    <div class="lang-row">
      <select id="langSelect">
        <option value="en-IN">English (en-IN)</option>
        <option value="hi-IN">Hindi (hi-IN)</option>
      </select>
    </div>
    <canvas id="wave" height="64"></canvas>
    <div class="vad-state">
      <span>VAD state: <b id="vadState">idle</b></span>
      <span>peak: <b id="vadPeak" class="mono">0</b></span>
    </div>
    <div class="diag" id="diag"></div>
  </div>

  <div class="panel">
    <h2><span class="dot" id="dotStt"></span>VAD + STT stream</h2>
    <div class="transcript" id="transcript"><span class="interim" id="placeholderText">— waiting for speech —</span></div>
    <div class="stat-row">
      <div class="stat"><span>latency</span><b id="statLatency">–</b></div>
      <div class="stat"><span>utterance</span><b id="statDur">–</b></div>
      <div class="stat"><span>chars</span><b id="statChars">–</b></div>
    </div>

    <div class="lang-panel">
      <h2><span class="dot" id="dotLang"></span>Language layer output</h2>
      <div class="lang-grid">
        <div class="field"><span>detected language</span><b id="fLang">–</b></div>
        <div class="field"><span>script</span><b id="fScript">–</b></div>
        <div class="field"><span>intent class</span><b id="fIntent">–</b></div>
        <div class="field"><span>urgency</span><b id="fUrgency">–</b></div>
      </div>
      <div class="bars">
        <div class="bar-col">
          <div class="bar-track"><div class="bar-fill audio" id="barAudio" style="height:0%"></div></div>
          <small id="lblAudio">raw audio 0B</small>
        </div>
        <div class="bar-col">
          <div class="bar-track"><div class="bar-fill text" id="barText" style="height:0%"></div></div>
          <small id="lblText">text payload 0B</small>
        </div>
      </div>
      <pre class="payload mono" id="payload">{ "status": "idle" }</pre>
    </div>
  </div>
</div>

<footer>
  <span>model refs: Vosk-Indic / IndicConformer (STT) · Bhashini ULCA (lang-id, prod) · this build: WebSpeech + rule-based NLP stand-in</span>
  <span id="clock" class="mono"></span>
</footer>

<script>
(function(){
  const $ = id => document.getElementById(id);
  const nodes = [$('node1'),$('node2'),$('node3')];
  const wires = [$('wire1'),$('wire2')];
  const statusBadge = $('statusBadge');

  function setActive(stage){
    nodes.forEach((n,i)=>n.classList.toggle('active', i<=stage));
    wires.forEach((w,i)=>w.classList.toggle('on', i<stage));
  }
  setActive(-1);

  // ---------- Alert / intent lexicon ----------
  const alertWords = ['flood','evacuate','warning','fire','help','urgent','danger','earthquake','cyclone',
    'बाढ़','चेतावनी','मदद','बचाओ','आग','खतरा','तुरंत','निकासी'];
  function classify(text){
    const lower = text.toLowerCase();
    const isAlert = alertWords.some(w=>lower.includes(w.toLowerCase()));
    return isAlert ? 'ALERT' : 'INFO';
  }
  function detectLang(text){
    const devanagari = /[\u0900-\u097F]/.test(text);
    return devanagari ? {lang:'hi', script:'Devanagari'} : {lang:'en', script:'Latin'};
  }

  function bytesOf(str){ return new TextEncoder().encode(str).length; }

  function updateLanguageLayer(text, durationSec){
    setActive(2);
    $('dotLang').className = 'dot ok';
    const {lang, script} = detectLang(text);
    const intent = classify(text);
    const urgency = intent === 'ALERT' ? 'HIGH' : 'NORMAL';
    $('fLang').textContent = lang === 'hi' ? 'Hindi' : 'English';
    $('fScript').textContent = script;
    $('fIntent').textContent = intent;
    const uEl = $('fUrgency');
    uEl.textContent = urgency;
    uEl.className = urgency === 'HIGH' ? 'urgent' : 'normal';

    const textBytes = bytesOf(text);
    const audioBytes = Math.round(Math.max(durationSec,1) * 16000 * 2); // 16kHz 16-bit mono estimate
    const maxB = Math.max(textBytes, audioBytes);
    $('barAudio').style.height = (audioBytes/maxB*100).toFixed(0)+'%';
    $('barText').style.height = (textBytes/maxB*100).toFixed(0)+'%';
    $('lblAudio').textContent = 'raw audio ~' + audioBytes + 'B';
    $('lblText').textContent = 'text payload ' + textBytes + 'B';

    const savings = (100 - (textBytes/audioBytes*100)).toFixed(1);
    $('payload').textContent = JSON.stringify({
      text, lang, script, intent, urgency,
      bytes: textBytes, est_audio_bytes: audioBytes,
      bandwidth_savings: savings + '%'
    }, null, 2);
  }

  // ---------- Demo chips (guaranteed-working fallback) ----------
  document.querySelectorAll('.chip').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      $('diag') && $('diag').classList.remove('show');
      const text = btn.dataset.text;
      const start = performance.now();
      setActive(1);
      $('dotStt').className='dot ok';
      $('transcript').innerHTML = '<span class="final">'+text+'</span>';
      const durationSec = text.split(' ').length * 0.35;
      setTimeout(()=>{
        const latency = Math.round(performance.now()-start);
        $('statLatency').textContent = latency+' ms';
        $('statDur').textContent = durationSec.toFixed(1)+' s';
        $('statChars').textContent = text.length;
        updateLanguageLayer(text, durationSec);
        statusBadge.textContent = 'PIPELINE OK';
      }, 250);
    });
  });

  // ---------- Waveform + VAD via WebAudio ----------
  let audioCtx, analyser, dataArray, rafId, mediaStream;
  const canvas = $('wave'), ctx = canvas.getContext('2d');
  function resizeCanvas(){ canvas.width = canvas.clientWidth * devicePixelRatio; canvas.height = 64*devicePixelRatio; }
  resizeCanvas(); window.addEventListener('resize', resizeCanvas);

  function drawWave(){
    rafId = requestAnimationFrame(drawWave);
    analyser.getByteTimeDomainData(dataArray);
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.lineWidth = 2*devicePixelRatio;
    ctx.strokeStyle = '#33E6C8';
    ctx.beginPath();
    let peak = 0;
    const slice = canvas.width / dataArray.length;
    for(let i=0;i<dataArray.length;i++){
      const v = dataArray[i]/128.0;
      const y = (v*canvas.height)/2;
      peak = Math.max(peak, Math.abs(v-1));
      i===0 ? ctx.moveTo(i*slice,y) : ctx.lineTo(i*slice,y);
    }
    ctx.stroke();
    const level = Math.round(peak*100);
    $('vadPeak').textContent = level;
    const speaking = level > 8;
    $('vadState').textContent = speaking ? 'speaking' : 'silence';
    $('vadState').style.color = speaking ? '#FF7A33' : '#7C89A8';
  }

  // ---------- Speech recognition ----------
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  let recognizer, recognizing = false, uStart = 0;

  function showDiag(msg){
    const d = $('diag');
    d.innerHTML = msg;
    d.classList.add('show');
  }
  function clearDiag(){ $('diag').classList.remove('show'); }

  function startRecognition(){
    clearDiag();
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
      showDiag('<b>No mic API here.</b> This browser/embedded view doesn\'t expose getUserMedia. Open the published link directly in a normal Chrome/Edge tab (desktop or Android), not inside an app webview — use the demo chips meanwhile.');
      recognizing = false; pttBtn.classList.remove('recording');
      return;
    }
    if(!SpeechRec){
      showDiag('<b>No speech recognizer here.</b> webkitSpeechRecognition isn\'t supported in this browser (common on iOS Safari, Firefox, and some webviews). Try Chrome on Android/desktop, or use the demo chips.');
      recognizing = false; pttBtn.classList.remove('recording');
      return;
    }
    navigator.mediaDevices.getUserMedia({audio:true}).then(stream=>{
      mediaStream = stream;
      audioCtx = new (window.AudioContext||window.webkitAudioContext)();
      const src = audioCtx.createMediaStreamSource(stream);
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 512;
      dataArray = new Uint8Array(analyser.fftSize);
      src.connect(analyser);
      drawWave();

      recognizer = new SpeechRec();
      recognizer.lang = $('langSelect').value;
      recognizer.continuous = true;
      recognizer.interimResults = true;
      uStart = performance.now();
      setActive(0);
      $('dotMic').className='dot live';
      statusBadge.textContent = 'LISTENING';

      recognizer.onresult = (e)=>{
        setActive(1);
        $('dotStt').className='dot live';
        let finalText='', interim='';
        for(let i=e.resultIndex;i<e.results.length;i++){
          const t = e.results[i][0].transcript;
          e.results[i].isFinal ? finalText+=t : interim+=t;
        }
        const box = $('transcript');
        box.innerHTML = (finalText? '<span class="final">'+finalText+'</span>':'') +
                         '<span class="interim">'+interim+'</span><span class="cursor"></span>';
        if(finalText.trim()){
          const latency = Math.round(performance.now()-uStart);
          const durationSec = (performance.now()-uStart)/1000;
          $('statLatency').textContent = latency+' ms';
          $('statDur').textContent = durationSec.toFixed(1)+' s';
          $('statChars').textContent = finalText.length;
          updateLanguageLayer(finalText.trim(), durationSec);
          uStart = performance.now();
        }
      };
      recognizer.onerror = (e)=>{
        statusBadge.textContent='MIC ERROR';
        const reasons = {
          'not-allowed':'Mic permission was denied — check your browser/site settings and allow microphone access, then try again.',
          'no-speech':'No speech detected — hold the button and speak closer to the mic.',
          'network':'The speech recognizer needs a network connection to reach the recognition service and couldn\'t. This is expected in fully offline setups — this demo path is a browser stand-in for the real on-device model anyway. Use the demo chips instead.',
          'audio-capture':'No microphone was found on this device.',
          'aborted':'Recognition was interrupted.'
        };
        showDiag('<b>Recognizer error: '+e.error+'.</b> '+(reasons[e.error]||'Use the demo chips below to drive the pipeline instead.'));
      };
      recognizer.start();
    }).catch(err=>{
      statusBadge.textContent = 'MIC BLOCKED';
      const msgs = {
        'NotAllowedError':'Microphone permission was denied or blocked by this page\'s host (common in embedded previews/webviews). Open the published artifact link directly in a full Chrome/Edge browser tab and allow the mic prompt.',
        'NotFoundError':'No microphone was found on this device.',
        'NotReadableError':'Another app is already using the microphone.',
        'SecurityError':'Mic access is blocked by this frame\'s permissions policy — open the link directly in a browser tab instead of inside an embedded app view.'
      };
      showDiag('<b>Mic access failed ('+(err.name||'unknown')+').</b> '+(msgs[err.name]||'Use the demo chips below the mic button to drive the pipeline instead.'));
      recognizing = false; pttBtn.classList.remove('recording');
    });
  }

  function stopRecognition(){
    recognizing = false;
    if(recognizer){ recognizer.onresult=null; recognizer.stop(); }
    if(rafId) cancelAnimationFrame(rafId);
    if(mediaStream) mediaStream.getTracks().forEach(t=>t.stop());
    if(audioCtx) audioCtx.close();
    $('dotMic').className='dot';
    $('vadState').textContent='idle';
    $('vadPeak').textContent='0';
    statusBadge.textContent = 'PIPELINE OK';
  }

  const pttBtn = $('pttBtn');
  function press(e){ e.preventDefault(); if(recognizing) return; recognizing=true; pttBtn.classList.add('recording'); startRecognition(); }
  function release(e){ e.preventDefault(); if(!recognizing) return; pttBtn.classList.remove('recording'); stopRecognition(); }
  pttBtn.addEventListener('mousedown', press);
  pttBtn.addEventListener('touchstart', press);
  pttBtn.addEventListener('mouseup', release);
  pttBtn.addEventListener('mouseleave', release);
  pttBtn.addEventListener('touchend', release);

  // clock
  setInterval(()=>{ $('clock').textContent = new Date().toLocaleTimeString(); }, 1000);
})();
</script>
</body>
</html>
